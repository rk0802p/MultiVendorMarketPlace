# ==============================================================================
# Multi-Vendor E-Commerce Marketplace - Environment Configuration Template
# Copy this file to .env and populate with your local/testing credentials.
# DO NOT COMMIT REAL CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas / Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/multivendor_marketplace
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/multivendor_marketplace?retryWrites=true&w=majority

# Redis Cache & Cart Store
REDIS_URL=redis://localhost:6379
REDIS_CART_TTL_SECONDS=604800 # 7 days

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN_DAYS=7

# Elasticsearch (Search & Filter Engine)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX=marketplace_products

# AWS S3 (Product Image Storage & Presigned URLs)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=multivendor-marketplace-images

# Payment Gateway (Razorpay - Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Marketplace Business Logic
PLATFORM_COMMISSION_PERCENTAGE=10
